def minmax_norm(x: float, vmin: float, vmax: float) -> float:
    return (x - vmin) / (vmax - vmin)


def minmax_denorm(x_norm: float, vmin: float, vmax: float) -> float:
    return x_norm * (vmax - vmin) + vmin


def make_context(
    age_norm: float,
    sex: float,
    cerebral_cortex: float,
    cerebral_white_matter: float,
    lateral_ventricle: float,
    device: str = "cuda",
    inputs_are_normalized: bool = True,
) -> torch.Tensor:
    """
    Build context in the exact order of const.CONDITIONING_VARIABLES:
    [age, sex, cerebral_cortex, cerebral_white_matter, lateral_ventricle]

    age_norm must already be in [0,1].
    sex is assumed 0 or 1.
    Regional inputs can be either normalized already or raw volumes.
    """

    if not inputs_are_normalized:
        cerebral_cortex = minmax_norm(
            cerebral_cortex,
            REGION_STATS["cerebral_cortex"]["min"],
            REGION_STATS["cerebral_cortex"]["max"],
        )
        cerebral_white_matter = minmax_norm(
            cerebral_white_matter,
            REGION_STATS["cerebral_white_matter"]["min"],
            REGION_STATS["cerebral_white_matter"]["max"],
        )
        lateral_ventricle = minmax_norm(
            lateral_ventricle,
            REGION_STATS["lateral_ventricle"]["min"],
            REGION_STATS["lateral_ventricle"]["max"],
        )

    context = torch.tensor(
        [[
            float(age_norm),
            float(sex),
            float(cerebral_cortex),
            float(cerebral_white_matter),
            float(lateral_ventricle),
        ]],
        dtype=torch.float32,
        device=device,
    )
    return context


def concat_covariates(_dict):
    """
    Provide context for cross-attention layers and concatenate the
    covariates in the channel dimension.
    """
    _dict['context'] = torch.tensor([ _dict[c] for c in const.CONDITIONING_VARIABLES ]).unsqueeze(0)
    return _dict

def make_orthogonal_montage(image: torch.Tensor) -> plt.Figure:
    """
    Given a 3D tensor (D,H,W), returns a matplotlib Figure
    showing the three center slices (sagittal, coronal, axial).
    """
    # ensure image is CPU numpy for plotting
    if image.ndim == 4 and image.shape[0] == 1:
        image = image.squeeze(0)
    D, H, W = image.shape

    mids = [D//2, H//2, W//2]

    plt.style.use('dark_background')
    fig, axes = plt.subplots(ncols=3, figsize=(7, 3))
    for ax in axes:
        ax.axis('off')

    axes[0].imshow(image[mids[0], :, :].cpu(), cmap='gray')
    axes[1].imshow(image[:, mids[1], :].cpu(), cmap='gray')
    axes[2].imshow(image[:, :, mids[2]].cpu(), cmap='gray')
    plt.tight_layout()
    return fig

def images_to_wandb(
    epoch: int,
    mode: str,
    autoencoder,
    diffusion,
    scale_factor: float,
    device: str = "cuda",
):
    """
    Sample 3 volumes using the same conditioning structure as training:
    [age, sex, cerebral_cortex, cerebral_white_matter, lateral_ventricle]
    """

    logs = {}

    # fixed reasonable tissue values around the dataset mean, normalized with min-max
    cortex_mean_norm = minmax_norm(
        REGION_STATS["cerebral_cortex"]["mean"],
        REGION_STATS["cerebral_cortex"]["min"],
        REGION_STATS["cerebral_cortex"]["max"],
    )
    wm_mean_norm = minmax_norm(
        REGION_STATS["cerebral_white_matter"]["mean"],
        REGION_STATS["cerebral_white_matter"]["min"],
        REGION_STATS["cerebral_white_matter"]["max"],
    )

    # three ventricle settings: small / medium / large
    vent_norm_values = [0.10, 0.30, 0.60]

    for i in range(3):
        age_norm = torch.rand(1, device=device).item()   # already [0,1]
        sex = float(torch.randint(0, 2, (1,), device=device).item())

        cortex_norm = cortex_mean_norm
        wm_norm = wm_mean_norm
        vent_norm = vent_norm_values[i]

        context = make_context(
            age_norm=age_norm,
            sex=sex,
            cerebral_cortex=cortex_norm,
            cerebral_white_matter=wm_norm,
            lateral_ventricle=vent_norm,
            device=device,
            inputs_are_normalized=True,
        )

        img = sample_using_diffusion(
            autoencoder=autoencoder,
            diffusion=diffusion,
            context=context,
            device=device,
            scale_factor=scale_factor,
            num_inference_steps=args.num_inf_steps,
        )

        fig = make_orthogonal_montage(img)

        age_years = 1.0 + 6.0 * age_norm
        vent_raw = minmax_denorm(
            vent_norm,
            REGION_STATS["lateral_ventricle"]["min"],
            REGION_STATS["lateral_ventricle"]["max"],
        )

        caption = (
            f"{mode} | age_norm={age_norm:.3f} (~{age_years:.2f}y) | "
            f"sex={int(sex)} | "
            f"ctx=[age={age_norm:.3f}, sex={int(sex)}, "
            f"cortex={cortex_norm:.3f}, wm={wm_norm:.3f}, vent={vent_norm:.3f}] | "
            f"vent≈{vent_raw:.0f}"
        )

        logs[f"{mode}/gen_{i}"] = wandb.Image(fig, caption=caption)
        plt.close(fig)

    wandb.log(logs)


